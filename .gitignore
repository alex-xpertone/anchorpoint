# ============================================================================
# anchorpoint — .gitignore
# Secrets and generated per-deployment configs NEVER go in the repo.
# Each operator generates their own (unique) keys/passwords locally.
# ============================================================================

# --- Secrets (your real values; keep ONLY the *.example in git) ---
secrets/*.sops.yaml
secrets/*.yaml
!secrets/*.example
*.sops.yaml
*.dec.yaml
*.plain.yaml
*.decrypted*

# --- Your real inventory (holds endpoints + public keys, and the DuckDNS token
#     before gen-mesh-secrets.py moves it into the encrypted bundle). Keep ONLY
#     the example in git. ---
inventory/*.yaml
!inventory/example.yaml

# --- age / GPG / TLS private key material — never in the repo ---
*.agekey
*.age
*.key
*.pem
key.txt
keys.txt

# --- Generated per-node output (rendered from your inventory + secrets) ---
deployments/

# --- Rendered diagrams (regenerate from .d2) ---
*.svg
*.png
# ...but DO keep the committed sample output under examples/ and the docs diagram
!examples/**/*.svg
!examples/**/*.png
!docs/**/*.svg
!docs/**/*.png

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc

# --- env ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
*.swp
*~
.idea/
.vscode/

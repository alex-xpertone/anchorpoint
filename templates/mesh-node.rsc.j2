# =============================================================================
# AnchorPoint Mesh — NODE CONFIG  {{ node.color | upper }} / {{ node.location }}
# Device: MikroTik hAP ax2 (5-port) · RouterOS v7 · full-mesh WireGuard
# -----------------------------------------------------------------------------
# ⚠ VALIDATE ON A ROUTEROS CHR VM OR SPARE hAP BEFORE PRODUCTION. Verify:
#     • wifi VAP syntax (/interface wifi add master-interface=…) on your ROS build
#     • bridge-port removal from the default bridge for ether2..ether5
#     • remove defconf's leftover 192.168.88.x address/DHCP if reset WITH defaults
#     • routing-rule order + lookup-only-in-table (leak-proof) behaviour
#     • each of the {{ node.exits|length }} tunnels comes up AND return traffic flows
#       both ways (this node exiting via a remote, AND being an exit for remotes)
# -----------------------------------------------------------------------------
# Port map for this node:
#   ether1 = WAN (uplink)
{% for x in node.exits %}
#   {{ x.ether }} = EXIT via {{ x.color | upper }} {{ x.location }} ({{ x.subnet }}, SSID "{{ x.ssid }}", UDP {{ x.pair_port }})
{% endfor %}
#   {{ node.local_ethers | join(', ') }} = LOCAL ({{ node.local_subnet }}, SSID "{{ node.ssid }}")
{% if node.client_peers %}
#   wg-clients (UDP {{ node.client_port }}) = roaming test devices: {{ node.client_peers | map(attribute='name') | join(', ') }} ({{ node.client_subnet }})
{% endif %}
# =============================================================================

#------------------------------------------------------------------------------
# 0. IDENTITY / TIME / CLOUD / HARDENING
#------------------------------------------------------------------------------
/system identity set name="mesh-{{ node.color }}"
/system clock set time-zone-name={{ mesh.timezone | default('UTC') }}
/user set [find name=admin] password="{{ secrets[node.color ~ '_admin_password'] }}"
/system ntp client set enabled=yes
/system ntp client servers add address=pool.ntp.org
/ip cloud set ddns-enabled=yes
/ip cloud force-update
/ip service disable ftp,telnet
/ipv6 settings set disable-ipv6=yes
/disk settings set auto-media-sharing=no auto-smb-sharing=no

#------------------------------------------------------------------------------
# 1. INTERFACE LISTS + WAN (ether1)
#------------------------------------------------------------------------------
/interface list add name=WAN comment="mesh"
/interface list add name=LAN comment="mesh"
/interface list member add interface=ether1 list=WAN
/ip dhcp-client add interface=ether1 disabled=no use-peer-dns=no comment="WAN uplink"

# Detach ether2..ether5 from the default bridge so each role gets its own network.
{% for x in node.exits %}
/interface bridge port remove [find interface={{ x.ether }}]
{% endfor %}
{% for e in node.local_ethers %}
/interface bridge port remove [find interface={{ e }}]
{% endfor %}

#------------------------------------------------------------------------------
# 2. OVERLAY IDENTITY  (stable 10.0.80.x — tunnel source + watchdog target)
#------------------------------------------------------------------------------
/interface bridge add name=bridge-overlay
/ip address add address={{ node.wg_ip }}/32 interface=bridge-overlay comment="mesh overlay id"
/interface list member add interface=bridge-overlay list=LAN

#------------------------------------------------------------------------------
# 3. WIREGUARD — one interface per remote (per-exit; unique UDP port per pair)
#    All interfaces share THIS node's single private key (=> one public key).
#------------------------------------------------------------------------------
{% for x in node.exits %}
/interface wireguard add name={{ x.iface }} listen-port={{ x.pair_port }} mtu=1420 \
    private-key="{{ secrets[node.color ~ '_wg_private_key'] }}" comment="tunnel {{ node.color }}<->{{ x.color }}"
/interface wireguard peers add interface={{ x.iface }} public-key="{{ x.public_key }}" \
    endpoint-address={{ x.ddns }} endpoint-port={{ x.pair_port }} \
    allowed-address=0.0.0.0/0 persistent-keepalive=25s comment="{{ x.color }} {{ x.location }}"
/interface list member add interface={{ x.iface }} list=LAN
# reach the remote's overlay IP through its tunnel (watchdog + return path).
# pref-src pins the source to THIS node's overlay IP so router-originated probes
# (the netwatch watchdog below) have a valid source — without it RouterOS cannot
# auto-select a source for a /32 via an addressless wg interface and the watchdog
# false-fails, bouncing the tunnel every interval.
/ip route add dst-address={{ x.remote_wg_ip }}/32 gateway={{ x.iface }} pref-src={{ node.wg_ip }} comment="overlay {{ x.color }}"
{% endfor %}

#------------------------------------------------------------------------------
# 4. LOCAL NETWORK  ({{ node.local_ethers | join(', ') }} + Wi-Fi "{{ node.ssid }}" -> local ISP)
#------------------------------------------------------------------------------
/interface bridge add name=bridge-local
{% for e in node.local_ethers %}
/interface bridge port add bridge=bridge-local interface={{ e }}
{% endfor %}
/interface list member add interface=bridge-local list=LAN
/ip address add address={{ node.local_gw }}/24 interface=bridge-local
/ip pool add name=pool-local ranges={{ node.local_gw[:-1] }}10-{{ node.local_gw[:-1] }}254
/ip dhcp-server add name=dhcp-local interface=bridge-local address-pool=pool-local disabled=no
/ip dhcp-server network add address={{ node.local_subnet }} gateway={{ node.local_gw }} dns-server={{ node.local_gw }}
/interface wifi set wifi1 configuration.mode=ap configuration.ssid="{{ node.ssid }}" \
    security.authentication-types=wpa2-psk,wpa3-psk security.passphrase="{{ secrets[node.color ~ '_wifi_passphrase'] }}" disabled=no
/interface bridge port add bridge=bridge-local interface=wifi1

#------------------------------------------------------------------------------
# 5. EXIT NETWORKS  (one per remote: wired port + matching Wi-Fi VAP)
#------------------------------------------------------------------------------
{% for x in node.exits %}
# --- EXIT via {{ x.color | upper }} ({{ x.location }}) ---
/interface bridge add name={{ x.bridge }}
/interface bridge port add bridge={{ x.bridge }} interface={{ x.ether }}
/interface list member add interface={{ x.bridge }} list=LAN
/ip address add address={{ x.gw }}/24 interface={{ x.bridge }}
/ip pool add name=pool-{{ x.color }} ranges={{ x.gw[:-1] }}10-{{ x.gw[:-1] }}254
/ip dhcp-server add name=dhcp-{{ x.color }} interface={{ x.bridge }} address-pool=pool-{{ x.color }} disabled=no
/ip dhcp-server network add address={{ x.subnet }} gateway={{ x.gw }} dns-server={{ x.gw }}
/interface wifi add name={{ x.vap }} master-interface=wifi1 configuration.mode=ap \
    configuration.ssid="{{ x.ssid }}" security.authentication-types=wpa2-psk,wpa3-psk \
    security.passphrase="{{ secrets[node.color ~ '_wifi_passphrase'] }}" disabled=no
/interface bridge port add bridge={{ x.bridge }} interface={{ x.vap }}
{% endfor %}

#------------------------------------------------------------------------------
# 5b. ROAMING CLIENTS  (your test devices join wg-clients -> full tunnel, exit HERE)
#     Reuses THIS node's key; each device dials {{ node.ddns }}:{{ node.client_port }}.
#------------------------------------------------------------------------------
{% if node.client_peers %}
/interface wireguard add name=wg-clients listen-port={{ node.client_port }} mtu=1420 \
    private-key="{{ secrets[node.color ~ '_wg_private_key'] }}" comment="roaming test clients"
/ip address add address={{ node.client_gw }}/24 interface=wg-clients
/interface list member add interface=wg-clients list=LAN
{% for c in node.client_peers %}
/interface wireguard peers add interface=wg-clients public-key="{{ c.public_key }}" \
    allowed-address={{ c.address }}/32 persistent-keepalive=25s comment="{{ c.name }}"
{% endfor %}
# accept the clients' WireGuard port on WAN; their traffic egresses via the mesh WAN masquerade (section 7)
/ip firewall filter add chain=input action=accept protocol=udp dst-port={{ node.client_port }} \
    in-interface-list=WAN comment="WG roaming clients" place-before=0
{% endif %}

#------------------------------------------------------------------------------
# 6. LEAK-PROOF POLICY ROUTING  (each exit subnet -> its tunnel, NO fallback)
#    + source-NAT exit traffic to THIS node's overlay IP so the remote exit node
#      can route replies straight back down the tunnel (10.0.80.x/32 route above).
#------------------------------------------------------------------------------
{% for x in node.exits %}
/routing table add name={{ x.table }} fib
/ip route add dst-address=0.0.0.0/0 gateway={{ x.iface }} routing-table={{ x.table }} comment="exit {{ x.color }}"
/routing rule add src-address={{ x.subnet }} action=lookup-only-in-table table={{ x.table }} comment="leak-proof {{ x.color }}"
/ip firewall nat add chain=srcnat action=src-nat to-addresses={{ node.wg_ip }} out-interface={{ x.iface }} comment="exit via {{ x.color }}: source from overlay"
{% endfor %}

#------------------------------------------------------------------------------
# 7. NAT (exit-node egress) + MSS clamp + disable FastTrack
#------------------------------------------------------------------------------
# When THIS node is an exit for a remote: remote traffic arrives (src 10.0.80.x)
# and egresses our WAN masqueraded. Also covers local-network internet.
/ip firewall nat add chain=srcnat action=masquerade out-interface-list=WAN comment="mesh WAN masquerade"
/ip firewall mangle add chain=forward action=change-mss new-mss=clamp-to-pmtu passthrough=yes \
    protocol=tcp tcp-flags=syn comment="mesh MSS clamp"
# FastTrack bypasses policy routing + MSS clamp -> disable it (leak risk).
/ip firewall filter set [find comment="defconf: fasttrack"] disabled=yes

#------------------------------------------------------------------------------
# 8. FIREWALL INPUT — accept each pair's WireGuard UDP port on WAN
#------------------------------------------------------------------------------
{% for x in node.exits %}
/ip firewall filter add chain=input action=accept protocol=udp dst-port={{ x.pair_port }} \
    in-interface-list=WAN comment="WG {{ node.color }}<->{{ x.color }}" place-before=0
{% endfor %}

#------------------------------------------------------------------------------
# 9. SELF-HEALING WATCHDOG  (per tunnel: fix clock, then bounce if truly dead)
#------------------------------------------------------------------------------
{% for x in node.exits %}
/tool netwatch add host={{ x.remote_wg_ip }} interval=1m timeout=2s type=simple name="wg-{{ x.color }}-watchdog" \
    up-script=":log info \"mesh: tunnel to {{ x.color }} UP\"" \
    down-script=":local s [/system ntp client get status]; :if (\$s != \"synchronized\") do={ /system ntp client set enabled=no; :delay 1s; /system ntp client set enabled=yes; :delay 10s }; :if ([/ping {{ x.remote_wg_ip }} count=3] = 0) do={ :log error \"mesh: {{ x.color }} tunnel dead, restarting\"; /interface wireguard disable {{ x.iface }}; :delay 2s; /interface wireguard enable {{ x.iface }} }"
{% endfor %}

# =============================================================================
# END mesh node {{ node.color }}.
# Forward these UDP ports on this site's ISP router: {{ node.exits | map(attribute='pair_port') | join(', ') }}{{ (", " ~ node.client_port ~ " (roaming clients)") if node.client_peers else "" }}
# =============================================================================

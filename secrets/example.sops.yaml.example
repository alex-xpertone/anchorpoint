# =============================================================================
# SECRETS bundle — EXAMPLE (placeholders only; NOT real values, NOT encrypted)
# =============================================================================
# Do NOT hand-fill this. Run:
#     scripts/gen-mesh-secrets.py --inventory inventory/example.yaml
# It generates each node's keypair + admin/wifi passwords (random) into the real,
# SOPS-ENCRYPTED  secrets/example.sops.yaml  (gitignored) and writes the PUBLIC
# keys back into the inventory. One block per node identifier you deploy.
# =============================================================================

hamburg_wg_private_key:  "REPLACE_hamburg_private_key"
hamburg_admin_password:  "REPLACE_hamburg_admin_password"
hamburg_wifi_passphrase: "REPLACE_hamburg_wifi_passphrase"

barcelona_wg_private_key:  "REPLACE_barcelona_private_key"
